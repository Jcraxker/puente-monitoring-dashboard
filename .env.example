# PostgreSQL (docker-compose.yml). Copy to .env and set real values. Never commit .env.
# Copiar a .env y completar valores reales. NUNCA commitear .env
POSTGRES_DB=puente
POSTGRES_USER=puente
POSTGRES_PASSWORD=change_me
BACKEND_PORT=3001

# Backend -> DB (compose uses host "db", local dev uses 127.0.0.1)
DATABASE_URL=postgres://puente:change_me@db:5432/puente

# Auth (long random: openssl rand -hex 32)
JWT_SECRET=change_me
JWT_EXPIRES_DAYS=30

# KoBoToolbox (ask monitoreo / KoBo account)
KOBO_TOKEN=
KOBO_FORM_UID=
KOBO_API_URL=https://kf.kobotoolbox.org

# Demo users: bcrypt hashes in .env (never commit).
# Generate: node -e "console.log(require('bcryptjs').hashSync('PASS',10))"
# Change demo passwords before production.
HASH_MONITOR=
HASH_GESTOR1=
HASH_TECNICO1=

# Allowed origins in dev (vite). Production serves frontend same-origin.
FRONTEND_ORIGIN=http://localhost:5173

HASH_ENC_PQL=
HASH_ENC_CAH=
