# PostgreSQL (docker-compose.yml). Copy to .env and set real values. Never commit .env.
POSTGRES_USER=puente
POSTGRES_PASSWORD=change_me
POSTGRES_DB=puente_dashboard
POSTGRES_PORT=5432

# Backend (used in later steps)
DATABASE_URL=postgres://puente:change_me@localhost:5432/puente_dashboard
JWT_SECRET=change_me
KOBO_TOKEN=
KOBO_ASSET_UID=your_kobo_asset_uid

# User password hashes (bcrypt). Generate with:
# node -e "console.log(require('bcryptjs').hashSync('YourPassword1$', 10))"
# Real values go in .env only. Example below is a hash of 'cambia-esto'.
HASH_MONITOR=$2b$10$EXAMPLEEXAMPLEEXAMPLEEXuDO NOT USEuTHISuHASHuINuPRODUCTION
HASH_GESTOR1=$2b$10$EXAMPLEEXAMPLEEXAMPLEEXuDO NOT USEuTHISuHASHuINuPRODUCTION
HASH_TECNICO1=$2b$10$EXAMPLEEXAMPLEEXAMPLEEXuDO NOT USEuTHISuHASHuINuPRODUCTION
