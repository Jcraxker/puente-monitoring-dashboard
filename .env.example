# PostgreSQL (docker-compose.yml). Copy to .env and set real values. Never commit .env.
POSTGRES_USER=puente
POSTGRES_PASSWORD=change_me
POSTGRES_DB=puente_dashboard
POSTGRES_PORT=5432

# Backend (used in later steps)
DATABASE_URL=postgres://puente:change_me@localhost:5432/puente_dashboard
JWT_SECRET=change_me
KOBO_TOKEN=
KOBO_ASSET_UID=your_kobo_asset_uid
